# https://editorconfig.org — khớp biome.json (2 space, lineWidth 110) (BASE-DATA-001: UTF-8).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Hai khoảng trắng cuối dòng có nghĩa là xuống dòng cứng trong Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
