{
  "name": "hotel-manager",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "prepare": "test -f scripts/install-git-hooks.mjs && node scripts/install-git-hooks.mjs || true",
    "dev:up": "node apps/web/scripts/dev-stack.ts",
    "build": "pnpm --recursive --filter \"./apps/*\" run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome ci --error-on-warnings .",
    "lint:openapi": "spectral lint apps/web/openapi.json --ruleset .spectral.yaml --fail-severity=warn",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:db": "vitest run --project db",
    "db:snapshot": "vitest run --project db schema-drift -u",
    "licenses:check": "node scripts/check-licenses.mjs",
    "openapi": "node apps/web/scripts/openapi.mjs",
    "build:tokens": "node scripts/build-tokens.mjs",
    "check:tokens": "node scripts/build-tokens.mjs --check",
    "gen:icons": "node apps/web/scripts/gen-icons.mjs",
    "check:contrast": "vitest run --project unit contrast",
    "size": "size-limit"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@biomejs/biome": "2.5.15",
    "@formatjs/icu-messageformat-parser": "3.5.20",
    "@lhci/cli": "0.15.1",
    "@size-limit/file": "14.1.0",
    "@stoplight/spectral-cli": "6.16.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.3",
    "happy-dom": "21.0.4",
    "size-limit": "14.1.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
